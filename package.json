{
  "name": "thinkube-theme",
  "displayName": "Thinkube Theme",
  "description": "Official Thinkube themes (light & dark) with teal brand colors, and a Lucide-based product icon theme",
  "version": "0.1.3",
  "publisher": "thinkube",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "light theme",
    "dark theme",
    "teal",
    "thinkube",
    "product icon theme",
    "lucide"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Thinkube Light",
        "uiTheme": "vs",
        "path": "./themes/thinkube-light.json"
      },
      {
        "label": "Thinkube Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/thinkube-dark.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "thinkube-icons",
        "label": "Thinkube Icons (Lucide)",
        "path": "./product-icons/thinkube-icons.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkube/thinkube-theme"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build:icons": "tsx scripts/build-product-icons.ts",
    "deploy": "scripts/deploy.sh"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "lucide-static": "1.26.0",
    "oslllo-svg-fixer": "6.0.1",
    "svg2ttf": "6.1.0",
    "svgicons2svgfont": "16.0.0",
    "tsx": "4.23.13",
    "ttf2woff": "3.0.0"
  }
}
